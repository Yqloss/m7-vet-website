[
  {
    "key": "ctrl+j",
    "command": "vim.remap",
    "when": "editorTextFocus && vim.active && !suggestWidgetVisible && !codeActionMenuVisible",
    "args": {
      "after": [
        "<Down>"
      ]
    }
  },
  {
    "key": "ctrl+j",
    "command": "cursorDown",
    "when": "editorTextFocus && !vim.active && !suggestWidgetVisible && !codeActionMenuVisible"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.terminal.sendSequence",
    "when": "terminalFocus",
    "args": {
      "text": "\u001b[B"
    }
  },
  {
    "key": "ctrl+k",
    "command": "vim.remap",
    "when": "editorTextFocus && vim.active && !suggestWidgetVisible && !codeActionMenuVisible",
    "args": {
      "after": [
        "<Up>"
      ]
    }
  },
  {
    "key": "ctrl+k",
    "command": "cursorUp",
    "when": "editorTextFocus && !vim.active && !suggestWidgetVisible && !codeActionMenuVisible"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.terminal.sendSequence",
    "when": "terminalFocus",
    "args": {
      "text": "\u001b[A"
    }
  },
  {
    "key": "ctrl+[",
    "command": "workbench.action.closeQuickOpen",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+[",
    "command": "hideSuggestWidget",
    "when": "suggestWidgetVisible && editorTextFocus"
  },
  {
    "key": "ctrl+[",
    "command": "workbench.action.terminal.sendSequence",
    "when": "terminalFocus",
    "args": {
      "text": "\u001b"
    }
  },
  {
    "key": "enter",
    "command": "workbench.action.showAllEditors",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !suggestWidgetVisible && !codeActionMenuVisible"
  },
  {
    "key": "tab",
    "command": "editor.action.quickFix",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !suggestWidgetVisible && !codeActionMenuVisible"
  },
  {
    "key": "ctrl+1",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+q",
    "command": "workbench.action.closeActiveEditor"
  },
  {
    "key": "ctrl+shift+q",
    "command": "workbench.action.closeOtherEditors"
  },
  {
    "key": "ctrl+shift+f",
    "command": "search.action.openNewEditor"
  },
  {
    "key": "ctrl+s",
    "command": "workbench.action.files.save",
    "when": "editorTextFocus"
  },
  {
    "key": "tab",
    "command": "-editor.action.inlineSuggest.commit"
  },
  {
    "key": "shift+tab",
    "command": "-outdent"
  },
  {
    "key": "shift+tab",
    "command": "-jumpToPrevSnippetPlaceholder"
  },
  {
    "key": "shift+tab",
    "command": "-extension.vim_shift+tab"
  },
  {
    "key": "shift+tab",
    "command": "editor.action.inlineSuggest.commit",
    "when": "editorTextFocus && inlineSuggestionVisible && !suggestWidgetVisible && !editorReadonly"
  },
  {
    "key": "ctrl+c",
    "command": "editor.action.clipboardCopyAction",
    "when": "editorTextFocus && editorHasSelection"
  },
  {
    "key": "ctrl+c",
    "command": "runCommands",
    "when": "editorTextFocus && !editorHasSelection",
    "args": {
      "commands": [
        "editor.action.selectAll",
        "editor.action.clipboardCopyAction",
        "cursorUndo"
      ]
    }
  },
  {
    "key": "ctrl+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+x",
    "command": "editor.action.clipboardCutAction",
    "when": "editorTextFocus && !editorReadonly && editorHasSelection"
  },
  {
    "key": "ctrl+x",
    "command": "runCommands",
    "when": "editorTextFocus && !editorReadonly && !editorHasSelection",
    "args": {
      "commands": [
        "editor.action.selectAll",
        "editor.action.clipboardCutAction"
      ]
    }
  },
  {
    "key": "ctrl+a",
    "command": "editor.action.selectAll",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+z",
    "command": "undo",
    "when": "editorTextFocus && !editorReadonly"
  }
]
